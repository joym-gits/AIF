# Required
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Optional — defaults shown
PORT=3001

# Required in production — the public URL this backend is served at.
# Baked into hosted feed_url values, so it MUST be correct before the first hosted feed is created.
PUBLIC_BASE_URL=http://localhost:3001

# Required in production — the public URL of the reader SPA. Used for share OG tags.
AIF_READER_URL=http://localhost:5174

# Required in production — comma-separated origins allowed via CORS.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

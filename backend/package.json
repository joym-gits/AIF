{
  "name": "@aif/backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../test/config/backend.vitest.config.ts",
    "test:unit": "vitest run --config ../test/config/backend.vitest.config.ts ../test/backend/unit",
    "test:integration": "vitest run --config ../test/config/backend.vitest.config.ts ../test/backend/integration",
    "test:coverage": "vitest run --config ../test/config/backend.vitest.config.ts --coverage"
  },
  "dependencies": {
    "@aif/shared": "*",
    "@supabase/supabase-js": "^2.45.0",
    "@types/sharp": "^0.31.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.2.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^8.0.5",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "sharp": "^0.34.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}

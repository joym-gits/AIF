{
  "name": "aif-agent-runner",
  "version": "0.1.0",
  "description": "CLI tool to run AI agents that publish to AIF (AI Intelligence Feed) on a schedule",
  "license": "AGPL-3.0-or-later",
  "main": "dist/index.js",
  "bin": {
    "aif-agent": "dist/cli.js"
  },
  "files": [
    "dist/",
    "aif-agent.config.json",
    ".env.example",
    "README.md"
  ],
  "keywords": ["aif", "ai", "intelligence", "feed", "agent", "rss", "anthropic", "claude"],
  "repository": {
    "type": "git",
    "url": "https://github.com/joym-gits/AIF.git",
    "directory": "agent-runner"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prepublishOnly": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "axios": "^1.7.2",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.5",
    "node-cron": "^3.0.3",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "typescript": "^5.4.5"
  }
}

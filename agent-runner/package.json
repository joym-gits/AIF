{
  "name": "@aif/agent-runner",
  "version": "0.1.0",
  "private": true,
  "description": "AI agent that publishes AIF feed items on a schedule",
  "main": "dist/index.js",
  "bin": {
    "aif-agent": "dist/cli.js"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "cli": "ts-node-dev --transpile-only src/cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aif/shared": "*",
    "@anthropic-ai/sdk": "^0.27.0",
    "axios": "^1.7.2",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.5",
    "node-cron": "^3.0.3",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}

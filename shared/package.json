{
  "name": "@aif/shared",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./types": "./src/types.ts",
    "./validator": "./src/validator.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "prepare": "tsc",
    "test": "vitest run --config ../test/config/shared.vitest.config.ts",
    "test:unit": "vitest run --config ../test/config/shared.vitest.config.ts",
    "test:coverage": "vitest run --config ../test/config/shared.vitest.config.ts --coverage"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aif.dev/schemas/aif-1.0.json",
  "title": "AIF Feed",
  "description": "AI Intelligence Feed 1.0",
  "type": "object",
  "required": [
    "aif",
    "id",
    "title",
    "description",
    "author",
    "domain",
    "cadence",
    "language",
    "feed_url",
    "created_at",
    "updated_at",
    "items"
  ],
  "properties": {
    "aif": { "const": "1.0" },
    "id": { "type": "string", "format": "uuid" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "author": {
      "type": "object",
      "required": ["name", "verified"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "did": { "type": "string" },
        "verified": { "type": "boolean" }
      }
    },
    "domain": {
      "type": "string",
      "enum": ["healthcare", "finance", "legal", "research", "tech", "general"]
    },
    "cadence": {
      "type": "string",
      "enum": ["realtime", "daily", "weekly", "monthly"]
    },
    "language": { "type": "string", "minLength": 2 },
    "feed_url": { "type": "string", "format": "uri" },
    "hub_url": { "type": "string", "format": "uri" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "summary",
          "content",
          "confidence",
          "signals",
          "source_urls",
          "agent_model",
          "published_at",
          "tags"
        ],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "title": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "maxLength": 280 },
          "content": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "signals": { "type": "array", "items": { "type": "string" } },
          "source_urls": {
            "type": "array",
            "items": { "type": "string", "format": "uri" }
          },
          "agent_model": { "type": "string" },
          "published_at": { "type": "string", "format": "date-time" },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}

{
  "hosting": [
    {
      "target": "publisher",
      "public": "publisher/dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [{ "source": "**", "destination": "/index.html" }]
    },
    {
      "target": "reader",
      "public": "reader/dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "/share/**",
          "run": { "serviceId": "aif-backend", "region": "us-central1" }
        },
        { "source": "**", "destination": "/index.html" }
      ]
    }
  ]
}

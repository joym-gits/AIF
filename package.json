{
  "name": "aif-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "AIF (AI Intelligence Feed) — open protocol for AI-generated intelligence streams",
  "workspaces": [
    "protocol",
    "backend",
    "extension",
    "publisher",
    "reader",
    "agent-runner",
    "shared"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=backend",
    "dev:publisher": "npm run dev --workspace=publisher",
    "dev:reader": "npm run dev --workspace=reader",
    "dev:extension": "npm run dev --workspace=extension",
    "build:all": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "test:dashboard": "node test/scripts/generate-dashboard.mjs",
    "test:report": "npm run test:coverage && npm run test:dashboard",
    "ci": "npm run typecheck && npm run test:unit && npm run test:integration && npm run build:all"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.7",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "supertest": "^7.2.2",
    "typescript": "^5.4.5",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=20"
  }
}
